        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "why": {
      "type": "tovi-features",
      "blocks": {
        "f1": {
          "type": "feature",
          "settings": {
            "icon": "puzzle",
            "tint": "sage",
            "title": "16 interlocking tiles",
            "text": "Snap together into a big 5.6 × 4 ft (67 × 48 in) play space."
          }
        },
        "f2": {
          "type": "feature",
          "settings": {
            "icon": "layers",
            "tint": "sky",
            "title": "0.5 in soft EVA",
            "text": "A soft cushioned landing for tummy time, first crawls and everyday play."
          }
        },
        "f3": {
          "type": "feature",
          "settings": {
            "icon": "shield",
            "tint": "coral",
            "title": "CPC / CPSIA tested",
            "text": "Tested to US children's product requirements."
          }
        },
        "f4": {
          "type": "feature",
          "settings": {
            "icon": "drop",
            "tint": "mustard",
            "title": "Wipe-clean top",
            "text": "Waterproof surface: spills wipe right off with a damp cloth."
          }
        }
      },
      "block_order": [
        "f1",
        "f2",
        "f3",
        "f4"
      ],
      "settings": {
        "eyebrow": "Made for little explorers",
        "heading": "Why parents love it",
        "disclaimer": "Always supervise children during play.",
        "color_scheme": "scheme-6",
        "card_color_scheme": "scheme-2"
      }
    },
    "sticky_atc": {
      "type": "tovi-sticky-atc",
      "settings": {
        "button_label": "Add to cart",
        "color_scheme": "scheme-2"
      }
    }
  },
  "order": [
    "main",
    "why",
    "disclosures",
    "related-products",
    "sticky_atc"
