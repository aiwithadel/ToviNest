{%- liquid
  assign link = section.settings.button_link
  if link == blank
    if section.settings.product != blank
      assign link = section.settings.product.url
    else
      assign link = routes.all_products_collection_url
    endif
  endif
-%}
<section class="tovi-hero color-{{ section.settings.color_scheme }} gradient" aria-labelledby="ToviHero-{{ section.id }}">
  <div class="page-width tovi-hero__inner">
    <div class="tovi-hero__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="tovi-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="ToviHero-{{ section.id }}" class="tovi-hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="tovi-hero__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      <div class="tovi-hero__buttons">
        {%- if section.settings.button_label != blank -%}
          <a class="button button--primary" href="{{ link }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank and section.settings.button_link_2 != blank -%}
          <a class="button button--secondary" href="{{ section.settings.button_link_2 }}">{{ section.settings.button_label_2 | escape }}</a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="tovi-chips" role="list">
          {%- for block in section.blocks -%}
            <li class="tovi-chip" {{ block.shopify_attributes }}>
              {%- render 'tovi-icon', icon: block.settings.icon -%}
              {{ block.settings.text | escape }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="tovi-hero__media">
      <div class="tovi-hero__blob"></div>
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(min-width: 990px) 50vw, 100vw',
            widths: '375, 550, 750, 1100, 1400'
        }}
      {%- else -%}
        <img
          src="{{ 'tovi-hero-dino-box.webp' | asset_url }}"
          alt="Dino, the Tovi Nest mascot, with the Moon Walkers RainBoho playmat box"
          width="1052"
          height="932"
          fetchpriority="high"
        >
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tovi hero",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Dino with the RainBoho box. Transparent PNG/WebP works best. Until you upload one, the built-in Dino + box image is used." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Moon Walkers Premium EVA Playmat" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Little explorer. <em>Big heart.</em>", "info": "Italic text is shown in sage green." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "A soft, cushioned nest for tummy time, first crawls, and everyday play." },
    { "type": "product", "id": "product", "label": "Product (button destination)" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the mat" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to link to the product above." },
    { "type": "text", "id": "button_label_2", "label": "Second button label" },
    { "type": "url", "id": "button_link_2", "label": "Second button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Chip",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [
          { "value": "shield", "label": "Shield" }, { "value": "ruler", "label": "Ruler" }, { "value": "layers", "label": "Layers" },
          { "value": "truck", "label": "Truck" }, { "value": "drop", "label": "Drop" }, { "value": "heart", "label": "Heart" },
          { "value": "puzzle", "label": "Puzzle" }, { "value": "gift", "label": "Gift" } ] },
        { "type": "text", "id": "text", "label": "Text", "default": "CPC / CPSIA tested" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tovi hero",
      "blocks": [
        { "type": "chip", "settings": { "icon": "ruler", "text": "5.6 × 4 ft" } },
        { "type": "chip", "settings": { "icon": "shield", "text": "CPC / CPSIA tested" } },
        { "type": "chip", "settings": { "icon": "truck", "text": "Ships across the USA" } }
      ]
    }
  ]
}
{% endschema %}
