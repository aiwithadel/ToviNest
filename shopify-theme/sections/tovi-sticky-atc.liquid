{%- comment -%}
  Mobile sticky add-to-cart for product pages. Appears when the main "Add to cart" button scrolls
  out of view (screens < 750px), mirrors the selected variant's price, and clicks the real
  button, so variant, quantity and Dawn's cart drawer behave exactly as in the main form.
{%- endcomment -%}
{%- if product -%}
  <tovi-sticky-atc class="tovi-sticky-atc color-{{ section.settings.color_scheme }}" data-label="{{ section.settings.button_label | escape }}">
    <div class="tovi-sticky-atc__inner">
      <div class="tovi-sticky-atc__info">
        <span class="tovi-sticky-atc__title">{{ product.title | escape }}</span>
        <span class="tovi-sticky-atc__price" data-sticky-price>{{ product.selected_or_first_available_variant.price | money }}</span>
      </div>
      <button type="button" class="button button--primary" data-sticky-button>
        {{- section.settings.button_label | escape -}}
      </button>
    </div>
  </tovi-sticky-atc>
  <script src="{{ 'tovi-sticky-atc.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Tovi sticky add to cart",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "presets": [ { "name": "Tovi sticky add to cart" } ]
}
{% endschema %}
